@page "/consulta-cnpj"
@using ERPW.Web.Models
@inject HttpClient Http
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3 class="card-title mb-3">Consulta CNPJ</h3>

                    <div class="input-group mb-3">
                        <input id="cnpjInput" class="form-control form-control-lg" @bind="cnpj" placeholder="00.000.000/0000-00" maxlength="18" inputmode="numeric" @onkeydown="HandleKeyDown" />
                        <button class="btn btn-primary" @onclick="Consultar">Consultar</button>
                        <button class="btn btn-outline-secondary" @onclick="Limpar">Limpar</button>
                    </div>

                    @if (loading)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <div class="spinner-border text-primary me-2" role="status"><span class="visually-hidden">Carregando...</span></div>
                            <span class="text-muted">Consultando...</span>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="container"><div class="alert alert-danger">@error</div></div>
}

@if (empresa != null)
{
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10">
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h4 class="mb-0">@empresa.Estabelecimento?.NomeFantasia ?? empresa.RazaoSocial</h4>
                                <small class="text-muted">@empresa.Estabelecimento?.CNPJ</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info text-dark me-1">@empresa.Porte?.Descricao</span>
                                <span class="badge bg-secondary">@empresa.Estabelecimento?.SituacaoCadastral</span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12 col-md-6">
                                <h6>Contato</h6>
                                <p class="mb-1"><strong>Telefone:</strong> @empresa.Estabelecimento?.Telefone1</p>
                                <p class="mb-1"><strong>Email:</strong> @empresa.Estabelecimento?.Email</p>
                                <p class="mb-1"><strong>Atividade:</strong> @empresa.Estabelecimento?.AtividadePrincipal?.Descricao</p>
                            </div>
                            <div class="col-12 col-md-6">
                                <h6>Endereço</h6>
                                <p class="mb-1">@EnderecoCompleto()</p>
                                <div class="mt-2">
                                    <a class="btn btn-sm btn-outline-primary me-2" target="_blank" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(EnderecoCompleto())">Abrir no Maps</a>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CopyAddress">Copiar endereço</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (empresa.Estabelecimento?.InscricoesEstaduais != null && empresa.Estabelecimento.InscricoesEstaduais.Any())
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Inscrições Estaduais</h6>
                            <ul class="mb-0">
                                @foreach (var ie in empresa.Estabelecimento.InscricoesEstaduais)
                                {
                                    <li>@ie.Numero - @ie.Estado?.Sigla (@(ie.Ativo ? "Ativa" : "Inativa"))</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6>JSON bruto</h6>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary me-2" @onclick="ToggleRaw">@((showJson) ? "Ocultar JSON" : "Mostrar JSON")</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="CopyJson">Copiar JSON</button>
                    </div>
                </div>

                @if (showJson)
                {
                    <pre style="max-height:320px;overflow:auto;background:#f8f9fa;padding:12px;border-radius:4px;">@rawJson</pre>
                }
            </div>
        </div>
    </div>
}

@code {
    private string cnpj = string.Empty;
    private bool loading = false;
    private Empresa? empresa;
    private string? rawJson;
    private string? error;
    private bool showJson = false;
    private bool maskInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeMask();
        }
    }

    private async Task InitializeMask()
    {
        if (maskInitialized) return;
        try
        {
            await JS.InvokeVoidAsync("cnpjMask.applyById", "cnpjInput");
        }
        catch
        {
            // ignore JS initialization errors
        }
        maskInitialized = true;
    }

    private async Task Consultar()
    {
        error = null;
        empresa = null;

        var c = (cnpj ?? string.Empty).Replace(".", "").Replace("/", "").Replace("-", "").Trim();
        if (string.IsNullOrEmpty(c) || c.Length != 14)
        {
            error = "Digite um CNPJ válido (14 dígitos).";
            return;
        }

        loading = true;
        try
        {
            var url = $"https://publica.cnpj.ws/cnpj/{c}";
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                error = $"Erro na consulta: {resp.StatusCode}";
                return;
            }

            rawJson = await resp.Content.ReadAsStringAsync();
            empresa = System.Text.Json.JsonSerializer.Deserialize<Empresa>(rawJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void Limpar()
    {
        cnpj = string.Empty;
        empresa = null;
        rawJson = null;
        error = null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Consultar();
        }
    }

    private async Task CopyAddress()
    {
        if (empresa?.Estabelecimento == null) return;
        var text = EnderecoCompleto();
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    private void ToggleRaw()
    {
        showJson = !showJson;
    }

    private async Task CopyJson()
    {
        if (string.IsNullOrEmpty(rawJson)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", rawJson);
    }

    private string EnderecoCompleto()
    {
        if (empresa?.Estabelecimento == null) return "-";
        var e = empresa.Estabelecimento;
        return $"{e.Logradouro}, {e.Numero} - {e.Bairro}, {e.Cidade?.Nome}/{e.Estado?.Sigla} - CEP: {e.CEP}";
    }
}
